DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
# Vector Search endpoint — Trial allows 1 endpoint; reusing vs_healthcare
VS_ENDPOINT=vs_healthcare
# Demo auth + PII salt (Block 35c, 35d) — generated locally, shared via 1Password
DEMO_KEY=
PII_SALT=

# ---------------------------------------------------------------------------
# Sponsor stack (feat/sponsor-stack) — all default off; flip per demo
# ---------------------------------------------------------------------------
SPONSOR_AGENT_BRICKS=false        # mount /sponsor/triage (MLflow ResponsesAgent)
SPONSOR_GENIE=false               # mount /sponsor/genie/query
SPONSOR_GENIE_LIVE=false          # if true, hit real Databricks Genie; else canned
SPONSOR_VOICE=false               # mount /sponsor/narrate (Fish Audio TTS)
SPONSOR_KA=false                  # KA stub — always falls back to JSON corpus
SAFE_DEMO=false                   # master kill-switch: all sponsor routes → canned

# Required when SPONSOR_GENIE_LIVE=true
DATABRICKS_GENIE_SPACE_ID=

# Required when SPONSOR_VOICE=true (Fish Audio sidecar reads same key)
FISH_API_KEY=
FISH_REFERENCE_ID=92a2600282e547f098b4a8de1bc9a44a

# Optional — set only if log_model targets a remote MLflow tracking server
MLFLOW_TRACKING_URI=
